<?xml version="1.0" encoding="utf-8"?>
<!--
  The webhook URL and shared secret live in EncryptedSharedPreferences and must never
  leave the device: no cloud backup, no device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
